# ==============================================================================
# VitalStock - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copie este archivo como `.env` si desea personalizar el puerto del receptor
# HTTP, la ruta de la base de datos SQLite o las credenciales semilla iniciales.

# Puerto local donde escucha el servidor HTTP receptor de pagos Yape (VitalNotifier)
VITALSTOCK_PORT=5005

# Ruta opcional hacia una base de datos SQLite personalizada (por defecto usa %APPDATA%/VitalStock/historial.db)
# VITALSTOCK_DB=C:/Ruta/Personalizada/historial.db

# Credenciales semilla para instalaciones nuevas (se almacenan con hash PBKDF2-HMAC-SHA256 + salt aleatorio)
VITALSTOCK_ADMIN_USER=admin
VITALSTOCK_ADMIN_PASS=admin123

VITALSTOCK_CAJA_USER=caja
VITALSTOCK_CAJA_PASS=caja123

VITALSTOCK_SOPORTE_USER=bowly
VITALSTOCK_SOPORTE_PASS=Soporte2026
